# Copiar a .env y completar localmente. No versionar .env.

# PostgreSQL local
POSTGRES_DB=catalogo
POSTGRES_USER=catalogo
POSTGRES_PASSWORD=replace-with-local-password

SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/catalogo
SPRING_DATASOURCE_USERNAME=catalogo
SPRING_DATASOURCE_PASSWORD=replace-with-local-password

# Servicio REST de la cátedra
CATEDRA_REST_URL=http://replace-with-course-host:8090
CATEDRA_TECHNICAL_JWT=replace-with-technical-jwt

# Credenciales Redis del objeto integration de cátedra
REDIS_HOST=replace-with-redis-host
REDIS_PORT=6379
REDIS_USERNAME=replace-with-redis-username
REDIS_PASSWORD=replace-with-redis-password

# Datos Kafka del objeto integration de cátedra (solo topic de catálogo)
KAFKA_BOOTSTRAP_SERVERS=replace-with-kafka-host:9094
KAFKA_CONSUMER_GROUP_ID=replace-with-consumer-group
KAFKA_CATALOG_TOPIC=replace-with-catalog-topic

# Reconciliación automática (opcional: estos son los valores por defecto)
CATALOG_RECONCILIATION_ENABLED=true
CATALOG_RECONCILIATION_INTERVAL=60s
CATALOG_RECONCILIATION_MAX_ATTEMPTS=3
CATALOG_RECONCILIATION_RETRY_DELAY=1s
