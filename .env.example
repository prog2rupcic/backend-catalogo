# Copiar a .env y completar localmente. No versionar .env.

# PostgreSQL local
POSTGRES_DB=catalogo
POSTGRES_USER=catalogo
POSTGRES_PASSWORD=replace-with-local-password

SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/catalogo
SPRING_DATASOURCE_USERNAME=catalogo
SPRING_DATASOURCE_PASSWORD=replace-with-local-password
# Servicio REST de la cátedra
CATEDRA_REST_URL=http://replace-with-course-host:8090
CATEDRA_TECHNICAL_JWT=replace-with-technical-jwt

# Integración Redis y Kafka (prevista para CAT-02; todavía no se consume)
REDIS_HOST=<redisHost-de-la-configuracion-vigente>
REDIS_PORT=<redisPort>
REDIS_USERNAME=<redisUsername>
REDIS_PASSWORD=<redisPassword-nueva>

KAFKA_BOOTSTRAP_SERVERS=<kafkaBootstrapServers>
KAFKA_CONSUMER_GROUP_ID=<kafkaConsumerGroupId>
KAFKA_CATALOG_TOPIC=<kafkaCatalogTopic>
